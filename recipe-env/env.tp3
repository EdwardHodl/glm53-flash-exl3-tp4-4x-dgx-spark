# fire triangle — .env.tp3 overrides for upstream start-tp3.sh
# Deployed on spark-e116.local as /home/spark/glm53-tp3/.env.tp3
#
# Topology (MAC-verified 2026-09-21) — a directed ring, exactly what the
# launcher requires (each node Port0 -> next node Port1):
#   e116  enp1s0f0np0 10.10.1.1  -> 3ff5 enp1s0f1np1 10.10.1.3
#   3ff5  enp1s0f0np0 10.10.2.3  -> 2ca4 enp1s0f1np1 10.10.2.2
#   2ca4  enp1s0f0np0 10.10.0.2  -> e116 enp1s0f1np1 10.10.0.1
# Ring order: 3ff5 -> 2ca4 -> e116 -> 3ff5.
#
# Control plane (gloo + NCCL bootstrap) rides the management LAN, per the
# launcher's 3-node guidance: each pair has its own /24 on the fabric, so no
# single CX7 interface reaches both peers. NCCL DATA still moves over RoCE via
# NCCL_IB_HCA (both HCAs per node) with subnet-aware routing.

WORKER2_IP=192.168.1.28
WORKER2_USER=spark
WORKER2_HOME=/home/spark

TP=3
NNODES=3
CONTAINER_HEAD=glm53-exl3-tp3-head
CONTAINER_WORKER=glm53-exl3-tp3-w1
CONTAINER_WORKER2=glm53-exl3-tp3-w2

# The three TP=3 shape fixes (nothing in GLM-5.3-Flash divides by 3)
TP3_HEAD_OVERRIDE=66            # 64 attention/KV heads -> 66 (local 22)
ENABLE_EXPERT_PARALLEL=1        # 288 routed experts / 3 = 96 whole experts/rank
MM_ENCODER_TP_MODE=data         # vision tower data-parallel
DFLASH_DRAFT_TP=1               # drafter has 32 heads / 8 kv -> cannot shard by 3

IMAGE=glm53-exl3:e3-v151
# Stock HF-cache loading — do NOT set LOAD_FORMAT=instanttensor: the local
# checkpoint cache is plain safetensors, no prepared InstantTensor cache exists.

NCCL_CROSS_NIC=1
NCCL_IB_SUBNET_AWARE_ROUTING=1  # match peers by subnet, not NIC index (3-ring)
NCCL_IB_GID_INDEX=3             # verified 3 on both ports, all 3 nodes
HEAD_GID=3
WORKER_GID=3
WORKER2_GID=3

HEAD_CX7_IF=enp1s0f1np1
HEAD_CX7_IB="rocep1s0f0,rocep1s0f1"
WORKER_CX7_IF=enp1s0f0np0
WORKER_CX7_IB="rocep1s0f0,rocep1s0f1"
WORKER2_CX7_IF=enp1s0f1np1
WORKER2_CX7_IB="rocep1s0f0,rocep1s0f1"

# Control-plane interfaces + advertised addresses (must be on that interface).
# e116 has wired LAN (enP7s7); the two workers are wifi-only on 192.168.1.x.
HEAD_SOCKET_IFNAME=enP7s7
HEAD_HOST_IP=192.168.1.6
WORKER_SOCKET_IFNAME=wlP9s9
WORKER_HOST_IP=192.168.1.31
WORKER2_SOCKET_IFNAME=wlP9s9
WORKER2_HOST_IP=192.168.1.28

NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_MAX_NCHANNELS=8
NCCL_MIN_NCHANNELS=8
NCCL_DEBUG=WARN

GLM53_MIXED_PREFILL_CHUNK=fair
GLM53_FAIR_PREFILL_CHUNK=256
GLM53_FAIR_PREFILL_SHARE=0.30
GLM53_FAIR_PREFILL_MAX_INTERVAL_MS=2000
GLM53_FAIR_PREFILL_MAX_STEP_MS=2000
GLM53_FAIR_PREFILL_MAX_CHUNKS=1
GLM53_DENSE_FP8=dense,kda
GLM53_APC_RETENTION_INTERVAL_SWA=0

# Serving shape (KV-capacity tuned 2026-09-21, measured anchors in fire README):
#   pool 20.03 GiB @0.70 = 804,434 tok = 906 page-ids; 451 ids per 400k request.
#   0.76 -> KV reserve 27.7 GiB; live pool 766,014 tok = 2.39x full-length 320k
#   slots (boot log: "Maximum concurrency for 320,000 tokens: 2.39x"). NOTE the
#   profiler hands the drafter graphs + UMA activation slack a bigger cut than
#   the arithmetic suggests (first-boot arithmetic said 3.40x; pinned KV via
#   EXTRA_ARGS --kv-cache-memory is the lever if we ever want it back).
#   max_num_seqs=6 needs temp-rows >= 6x(7+1)=48; cudagraph ladder stays at the
#   launcher default (1..32) — extending it to 40/48 OOM'd rank 2 during FULL
#   capture (2.23 GiB alloc failed with 32 GiB "free" = UMA accounting, not
#   capacity). Batches 5-6 decode slightly off-graph; acceptable trade.
#   6-stream queue threshold: sessions averaging >~127k tokens start queueing.
GPU_MEM_UTIL=0.76
MAX_NUM_SEQS=6
MAX_MODEL_LEN=320000
EXL3_TEMP_ROWS_FUSED=48
NFS_SHARE=0
ABLIT=0
CG_ESTIMATE=1
GLM53_BOOT_SHAPE_WARMUP=0
