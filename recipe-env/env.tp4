# fire-quad — .env.tp4 for upstream start-tp4.sh (GLM-5.3-Flash-EXL3, 4 ranks)
# Ring (MAC-verified 2026-09-25): e116 -> dc90 -> 3ff5 -> 2ca4 -> e116
#   edge A e116 f0 10.10.1.1 <-> dc90 enP2p1s0f1 10.10.1.2   (10.10.1.0/24)
#   edge B dc90 f0 10.10.3.1 <-> 3ff5 f1 10.10.3.2           (10.10.3.0/24)
#   edge C 3ff5 f0 10.10.2.3 <-> 2ca4 f1 10.10.2.4           (10.10.2.0/24)
#   edge D 2ca4 f0 10.10.0.3 <-> e116 f1 10.10.0.1           (10.10.0.0/24)
# Bootstrap/gloo on the mgmt LAN (tp3-proven pattern); RDMA on both HCAs per rank.

# --- ranks -----------------------------------------------------------------
HEAD_IP=192.168.1.6
WORKER_IP=192.168.1.2
WORKER2_IP=192.168.1.28
WORKER3_IP=192.168.1.31
WORKER2_SSH=spark@192.168.1.28
WORKER3_SSH=spark@192.168.1.31

# --- fabric ----------------------------------------------------------------
NCCL_CROSS_NIC=1
# bootstrap sockets on mgmt ifaces (tp3 pattern; RDMA data rides NCCL_IB_HCA)
HEAD_CX7_IF=enP7s7
WORKER_CX7_IF=wlP9s9
WORKER2_CX7_IF=wlP9s9
WORKER3_CX7_IF=wlP9s9
# dual-rail RDMA HCA lists (both cage views per node)
HEAD_CX7_IB=rocep1s0f0,rocep1s0f1
WORKER_CX7_IB=roceP2p1s0f1,rocep1s0f0
WORKER2_CX7_IB=rocep1s0f0,rocep1s0f1
WORKER3_CX7_IB=rocep1s0f1,rocep1s0f0
NCCL_IB_GID_INDEX=3
NCCL_DEBUG=WARN
NCCL_IB_MERGE_NICS=0
NCCL_IB_SUBNET_AWARE_ROUTING=1

# --- image/weights (same as tp3 lane) --------------------------------------
IMAGE=glm53-exl3:e3-v152
LOAD_FORMAT=instanttensor
GLM53_LOAD_CLONE=1
GLM53_LOAD_PREFETCH=0

# --- serve (TP=4) -----------------------------------------------------------
TP=4
NNODES=4
DFLASH_DRAFT_TP=4
PORT=8888
MASTER_PORT=29531
CONTAINER_HEAD=glm53-exl3-tp4-head
CONTAINER_WORKER=glm53-exl3-tp4-w1
CONTAINER_WORKER2=glm53-exl3-tp4-w2
CONTAINER_WORKER3=glm53-exl3-tp4-w3

# TP=4 measured knobs (.env.tp4.example receipts, punkjazz-labs 4x kit)
GPU_MEM_UTIL=0.75
MAX_NUM_SEQS=8
DFLASH_TOKENS=3
MAX_NUM_BATCHED_TOKENS=8192
GLM53_MIXED_PREFILL_CHUNK=off
# fire carries these two from the tp3 lane (post-PR238 + baked spinwait anchor)
GLM53_DRAFT_KV_COMPACT=1
GLM53_SPINWAIT_MS=16

# KV pool: tp4 launcher drops the shared .env pin (#204). Pin explicitly for 320k ctx.
EXTRA_ARGS="--kv-cache-memory-bytes 24000000000"
MAX_MODEL_LEN=320000
EXL3_FAT_SORTED=1
EXL3_FAT_BATCHED=1
EXL3_FAT_KERNEL=1
GLM53_INDEXER_WORKSPACE=rightsize
GLM53_BOOT_SHAPE_WARMUP=0
CG_ESTIMATE=1
